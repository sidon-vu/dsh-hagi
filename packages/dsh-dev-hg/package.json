{
  "name": "dsh-dev-hg",
  "version": "0.4.0",
  "description": "Development and operations for DeepSeek Harness: audit installed plugins, check profile health, snapshot and roll back changes.",
  "type": "module",
  "license": "MIT",
  "author": "HaGizen",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "src",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/guard.mjs && node test/doctor.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "market": {
      "category": "dev",
      "keywords": [
        "dsh",
        "dev",
        "ops",
        "profile",
        "i18n"
      ],
      "labels": []
    }
  }
}
