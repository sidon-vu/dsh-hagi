{
  "name": "dsh-template-hg",
  "version": "0.1.0",
  "private": true,
  "description": "Internal template: copy this directory to start a new hg plugin package.",
  "type": "module",
  "license": "MIT",
  "author": "HaGizen",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": false
    },
    "market": {
      "category": "dev",
      "keywords": [
        "dsh",
        "template"
      ],
      "labels": []
    }
  }
}
